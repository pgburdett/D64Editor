+#if defined(__linux__)
+/*
+ * Work around a systemd-libs/libudev runtime symbol lookup warning seen on
+ * some Linux distributions (e.g. Arch, systemd-libs 262.x): libudev may look
+ * up add_key/keyctl but libkeyutils is not linked/loaded, producing
+ * "undefined symbol: keyctl" on stderr during OpenCBM USB backend init.
+ * Preloading libkeyutils makes the symbols available; failure is non-fatal.
+ */
+__attribute__((constructor))
+static void
+xum1541_preload_keyutils(void)
+{
+    (void) dlopen("libkeyutils.so.1", RTLD_NOW | RTLD_GLOBAL);
+}
+#endif
