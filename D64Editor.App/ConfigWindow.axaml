<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.ConfigWindow"
        Title="Configuration"
        Width="380" Height="390"
        CanResize="False">

    <StackPanel Margin="16" Spacing="10">

        <TextBlock Text="File Import" FontWeight="Bold" />
        <Grid ColumnDefinitions="Auto,8,80,20,Auto,8,80">
            <TextBlock Grid.Column="0" Text="Starting Track:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="2" Name="StartTrackBox" Minimum="1" Maximum="35" />
            <TextBlock Grid.Column="4" Text="Starting Sector:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="6" Name="StartSectorBox" Minimum="0" Maximum="20" />
        </Grid>
        <Grid ColumnDefinitions="Auto,8,80">
            <TextBlock Grid.Column="0" Text="Interleave:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="2" Name="InterleaveBox" Minimum="1" Maximum="15" />
        </Grid>

        <Separator Margin="0,6,0,6" />

        <TextBlock Text="Options" FontWeight="Bold" />
        <!-- Mirrors checkDisableCrosslinkCheck / checkEnableSafeDiskClean / checkConvertToASCII / checkWarningMessages / treatTrack18FilesAsEmpty / seperatorLineText -->
        <CheckBox Name="DisableCrosslinkCheckBox" Content="Disable Crosslinked Files Check" />
        <CheckBox Name="SafeCleanBox" Content="Enable Safe Disk Clean (Skips Track 18)" />
        <CheckBox Name="ConvertToAsciiBox" Content="Convert SEQ file from PETASCII->ASCII" />
        <CheckBox Name="WarningsDisabledBox" Content="Disable Most Warning Messages" />
        <CheckBox Name="TreatTrack18AsEmptyBox" Content="Treat Track 18/0-1 starting files as empty when copying" />
        <Grid ColumnDefinitions="Auto,8,*" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="Separator line text:" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Name="SeparatorLineBox" MaxLength="16" />
        </Grid>

        <Button Content="Enable Changes" Click="OnEnableChangesClicked" HorizontalAlignment="Right" Margin="0,10,0,0" />

    </StackPanel>
</Window>