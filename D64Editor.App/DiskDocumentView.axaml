<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:D64Editor.App"
             x:Class="D64Editor.App.DiskDocumentView">

    <DockPanel Margin="8">

        <!-- Disk name/ID and address display-mode toggle -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="196,10,70,*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Disk Name" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskNameBox" MinWidth="180" IsReadOnly="True" Text="" FontSize="11"
                         FontFamily="{x:Static local:Fonts.Petscii}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="ID" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskIdBox" MinWidth="60" IsReadOnly="True" Text="" FontSize="11"
                         FontFamily="{x:Static local:Fonts.Petscii}" />
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Bottom">
                <TextBlock Text="Addresses" FontSize="11" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton Name="DecimalAddressRadio" GroupName="AddressBase" Content="Decimal" IsChecked="True"
                                 IsCheckedChanged="OnAddressBaseChanged" />
                    <RadioButton Name="HexAddressRadio" GroupName="AddressBase" Content="Hex"
                                 IsCheckedChanged="OnAddressBaseChanged" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom status bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="20" Margin="0,6,0,0">
            <TextBlock Name="FileCountLabel" Text="No disk loaded" />
            <TextBlock Name="BlocksFreeLabel" />
            <TextBlock Name="DiskTypeLabel" Opacity="0.7" />
        </StackPanel>

        <!-- Directory listing rendered like a C64 screen (ROM-bitmap, per-row for selection) -->
        <Border Name="DirectoryCanvas" Margin="0,0,0,8" Background="#0000AA" Padding="6">
            <ListBox Name="DirectoryList" Background="Transparent"
                     Foreground="#7797F5" SelectionMode="Multiple" DoubleTapped="OnDirectoryDoubleTapped">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DirectoryRow">
                        <local:PetsciiView Data="{Binding C64LineBytes}" Columns="48"
                                           Scale="2" Quotes="True" Lower="{Binding LowerCase}"
                                           Paper="6" Ink="14" ShowBorder="False" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</UserControl>
