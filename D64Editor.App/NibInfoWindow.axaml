<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.NibInfoWindow"
        Title="NIB Image"
        Width="420" Height="480">

    <DockPanel Margin="10">
        <TextBlock Name="TitleLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />
        <ListBox Name="TrackList" FontFamily="Consolas,Monospace" FontSize="12" />
    </DockPanel>
</Window>
