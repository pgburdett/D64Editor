<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.MainWindow"
        Title="D64 Editor"
        Width="820" Height="560"
        MinWidth="640" MinHeight="420">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Disk">
                <MenuItem Header="_New..." Click="OnNewBlank" />
                <MenuItem Header="_Open..." Click="OnOpen" />
                <MenuItem Header="Open in Ne_w Tab" Click="OnOpenNewTab" />
                <MenuItem Header="New _Tab" Click="OnNewTab" />
                <MenuItem Header="_Save" Click="OnSave" />
                <MenuItem Header="Save _As..." Click="OnSaveAs" />
                <MenuItem Header="_Revert" Click="OnRevert" />
                <Separator />
                <MenuItem Header="_Print Directory..." Click="OnPrint" />
                <MenuItem Header="Show DEL Files" Click="OnShowDel" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnQuitClicked" />
            </MenuItem>
            <MenuItem Header="_File">
                <MenuItem Header="_Import..." Click="OnImport" />
                <MenuItem Header="_Export..." Click="OnExport" />
                <MenuItem Header="Export Directory..." Click="OnExportDir" />
                <MenuItem Header="Copy Files to _Memory..." Click="OnMemory" />
                <Separator />
                <MenuItem Header="_Properties..." Click="OnProperties" />
                <MenuItem Header="_Rename" Click="OnRename" />
                <MenuItem Header="_Delete" Click="OnScratch" />
                <MenuItem Header="_Undelete" Click="OnUnscratch" />
                <Separator />
                <MenuItem Header="Find in Disks..." Click="OnFindInDisksClicked" />
                <MenuItem Header="Compare Disks..." Click="OnCompareDisksClicked" />
                <MenuItem Header="Batch Processing..." Click="OnBatchClicked" />
                <Separator />
                <MenuItem Header="_View File..." Click="OnViewSeq" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Select _All" Click="OnSelectAll" />
                <MenuItem Header="_Unselect All" Click="OnUnselectAll" />
                <MenuItem Header="_Invert Selection" Click="OnInvertSelection" />
                <Separator />
                <MenuItem Header="Scratch File" Click="OnScratch" />
                <MenuItem Header="Unscratch File..." Click="OnUnscratch" />
                <MenuItem Header="Wipe File" Click="OnWipe" />
                <MenuItem Header="Remove Directory Entry" Click="OnRemoveEntry" />
                <MenuItem Header="Move File To The Top" Click="OnMoveTop" />
                <MenuItem Header="Move File To The Bottom" Click="OnMoveBottom" />
                <Separator />
                <MenuItem Header="Edit BAM..." Click="OnBam" />
                <MenuItem Header="Sector/Block Editor..." Click="OnSectorEditor" />
                <MenuItem Header="Filename Builder..." Click="OnFilenameBuilder" />
                <MenuItem Header="Add Separator..." Click="OnAddSeparator" />
                <MenuItem Header="Copy Selected into Separator Builder..." Click="OnCopyIntoSeparator" />
                <Separator />
                <MenuItem Header="Trim File..." Click="OnTrimFile" />
                <MenuItem Header="Options..." Click="OnConfig" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Case" Click="OnToggleCase" />
                <MenuItem Header="Font _Size..." Click="OnFontSize" />
                <MenuItem Header="Refresh" Click="OnRefresh" />
                <Separator />
                <MenuItem Header="View File Chain" Click="OnViewFileChain" />
                <MenuItem Header="View SEQ File" Click="OnViewSeq" />
                <MenuItem Header="View REL File" Click="OnViewRel" />
                <MenuItem Header="View Error Blocks" Click="OnErrorBlocks" />
                <MenuItem Header="View Cross-Links" Click="OnCrossLinks" />
                <Separator />
                <MenuItem Header="Hex Viewer" Click="OnHexViewer" />
                <MenuItem Header="BASIC Viewer" Click="OnBasicViewer" />
                <MenuItem Header="Disassembly Viewer" Click="OnDisasmViewer" />
                <MenuItem Header="Picture Viewer (Koala/Art Studio)" Click="OnPictureViewer" />
                <MenuItem Header="Charset Viewer" Click="OnCharsetViewer" />
                <MenuItem Header="Sprite Viewer" Click="OnSpriteViewer" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="Run in _Emulator..." Click="OnRunEmulator" />
                <MenuItem Header="Configure _Emulators..." Click="OnConfigureEmulators" />
            </MenuItem>
            <MenuItem Header="C_BM">
                <MenuItem Header="_OpenCBM Transfer..." Click="OnOpenCbm" />
            </MenuItem>
            <MenuItem Header="_Window" Name="WindowMenu" SubmenuOpened="OnWindowMenuOpened">
                <MenuItem Header="New _Tab" Click="OnNewTab" />
                <MenuItem Header="Close Tab" Click="OnCloseTab" />
                <Separator />
                <!-- open documents (tabs) are rebuilt here on open -->
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates..." Click="OnCheckForUpdates" />
                <Separator />
                <MenuItem Header="_Version" Click="OnVersion" />
                <MenuItem Header="_About" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Toolbar (DirMaster-style quick actions) + color selectors on the right -->
        <Border DockPanel.Dock="Top" Margin="6,4,6,6" Padding="4" BorderThickness="0,0,0,1" BorderBrush="#40808080">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Content="Open" Click="OnOpen" />
                    <Button Content="Save" Click="OnSave" />
                    <Button Content="New" Click="OnNewBlank" />
                    <Separator />
                    <Button Content="Import" Click="OnImport" />
                    <Button Content="Export" Click="OnExport" />
                    <Separator />
                    <Button Content="BAM" Click="OnBam" />
                    <Button Content="Config" Click="OnConfig" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <ComboBox Name="PrimaryColorCombo" SelectedIndex="0" Width="90" SelectionChanged="OnColorChanged">
                        <ComboBoxItem Content="Blue" />
                        <ComboBoxItem Content="Green" />
                        <ComboBoxItem Content="Red" />
                        <ComboBoxItem Content="Purple" />
                    </ComboBox>
                    <ComboBox Name="SecondaryColorCombo" SelectedIndex="0" Width="90" SelectionChanged="OnColorChanged">
                        <ComboBoxItem Content="Lt Blue" />
                        <ComboBoxItem Content="Lt Green" />
                        <ComboBoxItem Content="Lt Red" />
                        <ComboBoxItem Content="Lt Purple" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabbed document workspace (single-window MDI) -->
        <TabControl Name="DocTabs" Margin="6" />

    </DockPanel>
</Window>
