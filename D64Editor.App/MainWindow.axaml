<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.MainWindow"
        Title="D64 Editor"
        Width="720" Height="480"
        MinWidth="560" MinHeight="360">

    <DockPanel Margin="10">

        <!-- Top bar: Open button + disk name/ID, mirrors frmMain's cmdOpen / txtDiskName / txtDiskID -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,12,140,10,60,*" Margin="0,0,0,10">
            <Button Grid.Column="0" Content="Open D64..." Click="OnOpenClicked" />
            <Button Grid.Column="2" Content="Import File..." Click="OnImportClicked" />
            <Button Grid.Column="4" Content="Export Selected..." Click="OnExportClicked" />
            <Button Grid.Column="6" Content="BAM Editor..." Click="OnBamEditorClicked" />
            <Button Grid.Column="8" Content="Sector Dump..." Click="OnSectorDumpClicked" />
            <Button Grid.Column="10" Content="Memory..." Click="OnMemoryClicked" />

            <StackPanel Grid.Column="12" Orientation="Vertical">
                <TextBlock Text="Disk Name" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskNameBox" IsReadOnly="True" />
            </StackPanel>

            <StackPanel Grid.Column="14" Orientation="Vertical">
                <TextBlock Text="ID" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskIdBox" IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <!-- Bottom bar: status text, mirrors frmMain's lblFileCount / lblBlocksFree / lblDiskType -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
            <TextBlock Name="FileCountLabel" Text="No disk loaded" />
            <TextBlock Name="BlocksFreeLabel" />
            <TextBlock Name="DiskTypeLabel" Opacity="0.7" />
        </StackPanel>

        <!-- Directory listing, mirrors frmMain's List1 -->
        <ListBox Name="DirectoryList" FontFamily="monospace" />

    </DockPanel>
</Window>
