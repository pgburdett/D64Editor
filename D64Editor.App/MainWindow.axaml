<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.MainWindow"
        Title="D64 Editor"
        Width="760" Height="500"
        MinWidth="600" MinHeight="380">

    <DockPanel Margin="10">

        <!-- Mirrors frmMain's menu bar (mnuFile/mnuEdit/mnuView/mnuHelp). Items with no
             handler wired up yet are disabled rather than silently missing, since those
             forms/features aren't ported (see README). -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Load D64 File..." Click="OnOpenClicked" />
                <MenuItem Header="_Save D64 File" Click="OnSaveClicked" />
                <MenuItem Header="_Trim File..." Click="OnTrimFileClicked" />
                <MenuItem Header="_Revert" Click="OnRevertClicked" />
                <Separator />
                <MenuItem Header="_Create Blank D64..." Click="OnCreateBlankClicked" />
                <MenuItem Header="Configuration _Menu" Click="OnConfigClicked" />
                <Separator />
                <MenuItem Header="_Quit" Click="OnQuitClicked" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="File _Export..." Click="OnExportClicked" />
                <MenuItem Header="File _Import..." Click="OnImportClicked" />
                <MenuItem Header="Copy Files to _Memory..." Click="OnMemoryClicked" />
                <MenuItem Header="Export _DIR to TXT..." Click="OnExportDirClicked" />
                <Separator />
                <MenuItem Header="Modify File _Properties" Click="OnFilePropertiesClicked" />
                <MenuItem Header="_Scratch File" Click="OnScratchClicked" />
                <MenuItem Header="_Unscratch File..." Click="OnUnscratchClicked" />
                <MenuItem Header="_Wipe File" Click="OnWipeClicked" />
                <MenuItem Header="_Remove Directory Entry" Click="OnRemoveEntryClicked" />
                <Separator />
                <MenuItem Header="Edit _BAM..." Click="OnBamEditorClicked" />
                <MenuItem Header="Block Export... (Sector Dump)" Click="OnSectorDumpClicked" />
                <MenuItem Header="_Filename Builder..." Click="OnFilenameBuilderClicked" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_View File Chain" Click="OnViewFileChainClicked" />
                <MenuItem Header="_SEQ File Viewer" Click="OnSeqViewerClicked" />
                <MenuItem Header="View _Error Blocks" Click="OnErrorBlocksClicked" />
                <MenuItem Header="View _Cross-Links" Click="OnCrossLinksClicked" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Version" Click="OnVersionClicked" />
            </MenuItem>
        </Menu>

        <!-- Disk name/ID, mirrors frmMain's txtDiskName / txtDiskID -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="140,10,60,*,Auto" Margin="0,8,0,10">
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Disk Name" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskNameBox" IsReadOnly="True" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="ID" FontSize="11" Opacity="0.7" />
                <TextBox Name="DiskIdBox" IsReadOnly="True" />
            </StackPanel>

            <!-- Start/end address display mode -->
            <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Bottom">
                <TextBlock Text="Addresses" FontSize="11" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton Name="DecimalAddressRadio" GroupName="AddressBase" Content="Decimal" IsChecked="True"
                                 Checked="OnAddressBaseChanged" />
                    <RadioButton Name="HexAddressRadio" GroupName="AddressBase" Content="Hex"
                                 Checked="OnAddressBaseChanged" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom bar: status text, mirrors frmMain's lblFileCount / lblBlocksFree / lblDiskType -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
            <TextBlock Name="FileCountLabel" Text="No disk loaded" />
            <TextBlock Name="BlocksFreeLabel" />
            <TextBlock Name="DiskTypeLabel" Opacity="0.7" />
        </StackPanel>

        <!-- Directory listing, mirrors frmMain's List1 header row + entries, extended with
             computed START/END address columns (not in the original) and a hex/decimal toggle -->
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,100,90,90,70,70,90,90" Margin="4,0,4,4">
                <TextBlock Grid.Column="0" Text="FILENAME" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="STARTING TRACK" FontWeight="Bold" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="STARTING SECTOR" FontWeight="Bold" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="BLOCKS" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Grid.Column="4" Text="TYPE" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Grid.Column="5" Text="" />
                <TextBlock Grid.Column="6" Text="START ADDR" FontWeight="Bold" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="7" Text="END ADDR" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>

            <ListBox Name="DirectoryList" FontFamily="monospace" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DirectoryRow">
                        <Grid ColumnDefinitions="*,100,90,90,70,70,90,90">
                            <TextBlock Grid.Column="0" Text="{Binding FileName, StringFormat='&quot;{0}&quot;'}" />
                            <TextBlock Grid.Column="1" Text="{Binding StartTrack}" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding StartSector}" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeInBlocks}" TextAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding TypeDisplay}" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="" />
                            <TextBlock Grid.Column="6" Text="{Binding StartAddressDisplay}" TextAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="{Binding EndAddressDisplay}" TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </DockPanel>
</Window>