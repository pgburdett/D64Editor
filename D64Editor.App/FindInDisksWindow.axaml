<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.FindInDisksWindow"
        Title="Find in Disks"
        Width="620" Height="460">

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,120,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Name="FolderBox" Grid.Column="1" />
            <Button Grid.Column="2" Content="…" Click="OnBrowseClicked" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="Filename contains:" VerticalAlignment="Center" Margin="6,0,6,0" />
            <TextBox Name="NeedleBox" Grid.Column="4" />
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox Name="CaseSensitiveBox" Content="Case sensitive" Margin="0,0,12,0" />
            <CheckBox Name="SearchContentsBox" Content="Search file contents" Margin="0,0,12,0" />
            <Button Content="Search" Click="OnSearchClicked" />
            <TextBlock Name="StatusLabel" Margin="12,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox Name="ResultsList" Background="Transparent"
                 FontFamily="{x:Static local:Fonts.Petscii}" FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:DiskSearchResultRow">
                    <TextBlock Text="{Binding Summary}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
