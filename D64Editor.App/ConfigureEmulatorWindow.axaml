<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.ConfigureEmulatorWindow"
        Title="Configure Emulator"
        Width="720" Height="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="OnSaveClicked" />
            <Button Content="Cancel" Click="OnCancelClicked" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Emulator command template (saved and reused for Run in Emulator):" FontWeight="Bold" />
            <TextBox Name="CommandBox" AcceptsReturn="False" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85">
                <Run Text="Placeholders: " /><Run Text="{}{disk}" FontFamily="monospace" /><Run Text=" = autostart target, " />
                <Run Text="{}{image}" FontFamily="monospace" /><Run Text=" = disk image path, " />
                <Run Text="{}{appdir}" FontFamily="monospace" /><Run Text=" = app folder (where D64Editor runs), " />
                <Run Text="{}{cwd}" FontFamily="monospace" /><Run Text=" = current working directory. " />
                <Run Text="Add any extra VICE/x128 options you want to keep (cartridges, fast-load, etc.)." />
            </TextBlock>
            <Border BorderThickness="1" BorderBrush="#555" Padding="8">
                <TextBlock TextWrapping="Wrap" FontSize="12" FontFamily="monospace"
                           Text="Examples:&#10;  x64sc -8 &quot;{image}&quot; -autostart &quot;{disk}&quot;&#10;  x64sc -cartcrt &quot;{appdir}/fastload.crt&quot; -8 &quot;{image}&quot; -autostart &quot;{disk}&quot;&#10;  x64sc -cartcrt &quot;{cwd}/fastload.crt&quot; -8 &quot;{image}&quot; -autostart &quot;{disk}&quot;&#10;  x128 -8 &quot;{image}&quot; -autostart &quot;{disk}&quot;" />
            </Border>
            <TextBlock Text="Tip: the saved command is persisted in app settings, so cartridges/fast-load flags stay configured."
                       FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
