<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.ConfigureEmulatorWindow"
        Title="Configure Emulator"
        Width="480" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Emulator command ({disk}=autostart target, {image}=disk path for mounting):" />
        <TextBox Name="CommandBox" />
        <TextBlock Text="Example: x64sc -8 &quot;{image}&quot; -autostart &quot;{disk}&quot;  (default mounts drive 8 automatically)" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save" Click="OnSaveClicked" />
            <Button Content="Cancel" Click="OnCancelClicked" />
        </StackPanel>
    </StackPanel>
</Window>
