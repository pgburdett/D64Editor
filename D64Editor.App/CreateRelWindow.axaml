<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.CreateRelWindow"
        Title="Create REL File"
        Width="360" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Create a new REL (relative) file on this disk." TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Filename:" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="2" Name="NameBox" MaxLength="16" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Record length:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="2" Name="RecordLengthBox" Minimum="1" Maximum="254" Value="1" FormatString="0" />
        </Grid>

        <TextBlock Name="StatusLabel" Foreground="OrangeRed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Create" Click="OnCreateClicked" />
            <Button Content="Cancel" Click="OnCancelClicked" />
        </StackPanel>
    </StackPanel>
</Window>
