<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.SeqViewerWindow"
        Title="SEQ File Viewer"
        Width="420" Height="560"
        MinWidth="320" MinHeight="360">

    <DockPanel Margin="8">

        <!-- Mirrors mnuSaveToText / mnuPrint (print isn't ported - no local printer story here) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Save to Text..." Click="OnSaveToTextClicked" />
            </MenuItem>
        </Menu>

        <TextBlock DockPanel.Dock="Top" Name="FileNameLabel" FontWeight="Bold" Margin="0,4,0,8" />

        <!-- Mirrors opt40/opt80 (window width preference) and OptASCII/OptPETASCII (character conversion) -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,20,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <RadioButton Name="Col40Radio" GroupName="Columns" Content="40 Column" IsChecked="True" Click="OnColumnsChanged" />
                <RadioButton Name="Col80Radio" GroupName="Columns" Content="80 Column" Click="OnColumnsChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <RadioButton Name="AsciiRadio" GroupName="CharMode" Content="ASCII" IsChecked="True" Click="OnCharModeChanged" />
                <RadioButton Name="PetasciiRadio" GroupName="CharMode" Content="PETASCII" Click="OnCharModeChanged" />
            </StackPanel>
        </Grid>

        <!-- Mirrors text1 -->
        <TextBox Name="ContentBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                  FontFamily="monospace" VerticalContentAlignment="Top" />

    </DockPanel>
</Window>
