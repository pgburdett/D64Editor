<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.SeqViewerWindow"
        Title="SEQ File Viewer"
        Width="520" Height="560"
        MinWidth="360" MinHeight="360">

    <DockPanel Margin="8">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Save to Text..." Click="OnSaveToTextClicked" />
            </MenuItem>
        </Menu>

        <TextBlock DockPanel.Dock="Top" Name="FileNameLabel" FontWeight="Bold" Margin="0,4,0,8" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,20,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <RadioButton Name="Col40Radio" GroupName="Columns" Content="40 Column" IsChecked="True"
                             Click="OnColumnsChanged" />
                <RadioButton Name="Col80Radio" GroupName="Columns" Content="80 Column" Click="OnColumnsChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <RadioButton Name="AsciiRadio" GroupName="CharMode" Content="ASCII" IsChecked="True"
                             Click="OnCharModeChanged" />
                <RadioButton Name="PetasciiRadio" GroupName="CharMode" Content="PETASCII" Click="OnCharModeChanged" />
            </StackPanel>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <local:PetsciiView Name="PetsciiContent" Columns="40" Scale="2"
                                   Quotes="False" Paper="6" Ink="14" Frame="14" />
                <TextBox Name="AsciiBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="monospace" IsVisible="False" BorderThickness="0" />
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>