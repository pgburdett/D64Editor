<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.RelViewerWindow"
        Title="REL File Viewer"
        Width="560" Height="480">

    <DockPanel Margin="10">
        <TextBlock Name="TitleLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Records:" VerticalAlignment="Center" />
            <NumericUpDown Name="RecordCountBox" Minimum="0" Maximum="65535" Width="120" FormatString="0" />
            <Button Content="Resize" Click="OnResizeClicked" />
            <TextBlock Name="ResizeStatus" VerticalAlignment="Center" Opacity="0.85" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <TextBlock Text="Record (hex bytes, space-separated):" VerticalAlignment="Center" />
                    <Button Content="Write Record" Click="OnWriteRecordClicked" />
                    <TextBlock Name="EditStatus" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Name="RecordBox" FontFamily="Consolas,Monospace" FontSize="12"
                         AcceptsReturn="True" MinHeight="80" />
            </StackPanel>
        </Border>

        <ListBox Name="RecordList" SelectionChanged="OnRecordSelected">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:RelRecordRow">
                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas,Monospace" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
