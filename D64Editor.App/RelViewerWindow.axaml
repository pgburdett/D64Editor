<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.RelViewerWindow"
        Title="REL File Viewer"
        Width="560" Height="480">

    <DockPanel Margin="10">
        <TextBlock Name="TitleLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBox Name="RecordBox" IsReadOnly="True" FontFamily="Consolas,Monospace" FontSize="12"
                     AcceptsReturn="True" MinHeight="120" />
        </Border>

        <ListBox Name="RecordList" SelectionChanged="OnRecordSelected">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:RelRecordRow">
                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas,Monospace" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
