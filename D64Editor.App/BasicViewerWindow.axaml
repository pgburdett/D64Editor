<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:D64Editor.App"
        x:Class="D64Editor.App.BasicViewerWindow"
        Title="BASIC Viewer"
        Width="680" Height="520">

    <DockPanel Margin="10">
        <TextBlock Name="TitleLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <local:PetsciiView Name="ListingView" Columns="40" Scale="2"
                               Quotes="True" Paper="6" Ink="14" Frame="14" />
        </ScrollViewer>
    </DockPanel>
</Window>