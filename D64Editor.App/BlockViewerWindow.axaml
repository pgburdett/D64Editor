<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.BlockViewerWindow"
        Title="Block Editor"
        Width="680" Height="560"
        MinWidth="600" MinHeight="480">

    <DockPanel Margin="8">

        <!-- Mirrors mnuWipeBlock / mnuSaveChangesToBlock / mnuDiscardChanges -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Wipe Block" Click="OnWipeClicked" />
                <Separator />
                <MenuItem Header="Save Changes to Block" Click="OnSaveClicked" />
                <MenuItem Header="Discard Changes" Click="OnDiscardClicked" />
            </MenuItem>
        </Menu>

        <!-- Mirrors lblBlockNum / lblBlockLocation / lblFileOwner, cmdPreviousBlock / cmdNextBlock, and chkViewASCII -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,8">
            <Button Grid.Column="0" Content="◄" Click="OnPreviousClicked" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="►" Click="OnNextClicked" Margin="0,0,16,0" />
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <TextBlock Name="BlockInfoLabel" FontFamily="monospace" FontWeight="Bold" />
                <TextBlock Name="OwnerLabel" FontFamily="monospace" Opacity="0.8" />
            </StackPanel>
            <CheckBox Grid.Column="3" Name="ViewAsciiCheckBox" Content="View ASCII" IsChecked="True" Click="OnViewAsciiToggled" VerticalAlignment="Center" />
        </Grid>

        <!-- Mirrors lblByte2Change / cmbByteChange: shows and edits the selected byte -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Selected byte:" VerticalAlignment="Center" />
            <TextBlock Name="SelectedByteOffsetLabel" FontFamily="monospace" VerticalAlignment="Center" Width="30" />
            <TextBox Name="ByteEditBox" Width="60" MaxLength="2" FontFamily="monospace" KeyDown="OnByteEditKeyDown" />
            <TextBlock Name="AutoBootLabel" Foreground="Orange" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Mirrors the lblBYTE(0..255) hex grid on the left, plus a PETSCII-ish ASCII
             column on the right (toggled by chkViewASCII), aligned row-for-row. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Name="GridPanel" Spacing="1" />
                <StackPanel Name="AsciiPanel" Spacing="1" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
