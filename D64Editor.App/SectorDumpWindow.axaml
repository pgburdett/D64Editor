<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.SectorDumpWindow"
        Title="Sector / Block Viewer"
        Width="860" Height="520"
        MinWidth="820">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="View and dump a sector's 256 bytes (hex + ASCII)." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,8,90,16,Auto,8,90,16,Auto,8,90,*,Auto,8,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="Track:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="2" Name="TrackBox" Minimum="1" Maximum="35" Value="1"
                               ValueChanged="OnTrackChanged" />
                <TextBlock Grid.Column="4" Text="Sector:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="6" Name="SectorBox" Minimum="0" Maximum="20" Value="0"
                               ValueChanged="OnSectorChanged" />
                <TextBlock Grid.Column="8" Text="Block:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="10" Name="BlockBox" Minimum="0" Maximum="682" Value="0"
                               ValueChanged="OnBlockChanged" />
                <Button Grid.Column="12" Content="◄ Prev" Click="OnPrevClicked" />
                <Button Grid.Column="14" Content="Next ►" Click="OnNextClicked" />
                <Button Grid.Column="16" Content="Dump to File..." Click="OnDumpClicked" />
            </Grid>
            <TextBlock Name="RangeHintLabel" Opacity="0.8" FontSize="12" />
        </StackPanel>

        <Border BorderThickness="1" BorderBrush="#555" Padding="6">
            <ScrollViewer>
                <TextBlock Name="DumpText" FontFamily="monospace" FontSize="13" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>