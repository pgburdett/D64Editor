<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.GfxViewerWindow"
        Title="Graphics Viewer"
        Width="680" Height="540">

    <DockPanel Margin="10">
        <TextBlock Name="TitleLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />

        <Border Background="#0000AA" Padding="8" HorizontalAlignment="Center">
            <Image Name="GfxImage" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None" />
        </Border>
    </DockPanel>
</Window>
