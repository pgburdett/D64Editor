<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.GfxViewerWindow"
        Title="Graphics Viewer"
        Width="760" Height="620">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBlock Name="TitleLabel" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" />
                <Slider Name="ZoomSlider" Minimum="1" Maximum="12" Value="4" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Name="ZoomLabel" VerticalAlignment="Center" Text="400%" Width="50" />
                <Button Content="Save Image..." Click="OnSaveClicked" />
            </StackPanel>
        </StackPanel>

        <Border Background="#0000AA" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Name="GfxImage" Stretch="None"
                       RenderOptions.BitmapInterpolationMode="None" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
