<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D64Editor.App.AboutWindow"
        Title="About the D64 Editor"
        Width="420" Height="220"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="D64 Editor" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="C#/.NET/Avalonia port of D64 Editor by Forrest Mook (1999-2016, GPL v2)." TextWrapping="Wrap" />
        <TextBlock Text="Original project: https://www.d64editor.com" TextWrapping="Wrap" />
        <TextBlock Name="ExtraLabel" Text="" TextWrapping="Wrap" />
        <Button Content="Close" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnCloseClicked" />
    </StackPanel>
</Window>
